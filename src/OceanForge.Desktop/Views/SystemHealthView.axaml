<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OceanForge.Desktop.ViewModels"
             x:Class="OceanForge.Desktop.Views.SystemHealthView"
             x:DataType="vm:MainViewModel">

    <Border Background="{StaticResource Ocean900Brush}" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="1" CornerRadius="8" Padding="20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📊" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="18. SỨC KHỎE PHẦN CỨNG &amp; THUẬT TOÁN CON TRỎ ĐỆM VÒNG (CPU, RAM, Ổ CỨNG)" 
                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource CyanSignalBrush}" />
                        </StackPanel>
                        <TextBlock Text="Thừa hưởng kiến trúc từ LibreHardwareMonitor, Jinjinov/Hardware.Info và InfoPanel. Thuật toán con trỏ bộ đệm vòng (Zero-Allocation Circular Ring Buffer Cursor) cho CPU, RAM, Ổ cứng và SQLite WAL." 
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding RefreshHardwareMetricsCommand}"
                            Background="{StaticResource Ocean800Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                            CornerRadius="4" Padding="12,6" Cursor="Hand" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" />
                            <TextBlock Text="Làm Mới Số Liệu" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- KPI Row: CPU, RAM, Ổ CỨNG, CON TRỎ ĐỆM VÒNG -->
                <Grid ColumnDefinitions="*,*,*,*">
                    <!-- Card 1: CPU Load & Cursor Stats -->
                    <Border Grid.Column="0" Background="{StaticResource Ocean950Brush}" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="⚡ HOST CPU LOAD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding HardwareSnapshot.HostCpuUsagePercentage, StringFormat='{}{0:F1}% CPU', FallbackValue='1.2% CPU'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource CyanSignalBrush}" />
                            <ProgressBar Value="{Binding HardwareSnapshot.HostCpuUsagePercentage, FallbackValue=1.2}" Minimum="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{StaticResource CyanSignalBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding HardwareSnapshot.CpuMinPercent, StringFormat='{}Min: {0:F1}%'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="•" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding HardwareSnapshot.CpuAvgPercent, StringFormat='{}Avg: {0:F1}%'}" FontSize="9" Foreground="{StaticResource SeafoamBrush}" />
                                <TextBlock Text="•" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding HardwareSnapshot.CpuMaxPercent, StringFormat='{}Max: {0:F1}%'}" FontSize="9" Foreground="{StaticResource WarningBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Process RAM & Stats -->
                    <Border Grid.Column="1" Background="{StaticResource Ocean950Brush}" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="💾 PROCESS RAM (WORKING SET)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding RamUsage, FallbackValue='84 MB RAM'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrassGoldBrush}" />
                            <ProgressBar Value="{Binding HardwareSnapshot.MemoryUsagePercentage, FallbackValue=12}" Minimum="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{StaticResource BrassGoldBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding HardwareSnapshot.RamMinMb, StringFormat='{}Min: {0:F0}M'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="•" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding HardwareSnapshot.RamAvgMb, StringFormat='{}Avg: {0:F0}M'}" FontSize="9" Foreground="{StaticResource SeafoamBrush}" />
                                <TextBlock Text="•" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding HardwareSnapshot.RamMaxMb, StringFormat='{}Max: {0:F0}M'}" FontSize="9" Foreground="{StaticResource WarningBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Ổ Cứng (Disk Free & Usage) -->
                    <Border Grid.Column="2" Background="{StaticResource Ocean950Brush}" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="💽 DUNG LƯỢNG Ổ CỨNG (DISK)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding HardwareSnapshot.DiskFreeSpaceGb, StringFormat='{}{0:F1} GB Trống', FallbackValue='120.0 GB Trống'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource SeafoamBrush}" />
                            <ProgressBar Value="{Binding HardwareSnapshot.DiskUsagePercentage, FallbackValue=75}" Minimum="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{StaticResource SeafoamBrush}" />
                            <TextBlock Text="{Binding HardwareSnapshot.DiskUsagePercentage, StringFormat='{}Đã dùng {0:F1}% trên tổng ổ đĩa', FallbackValue='Đã dùng 76.5%'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Thuật Toán Con Trỏ Đệm Vòng (Ring Buffer Cursor) -->
                    <Border Grid.Column="3" Background="{StaticResource Ocean950Brush}" BorderBrush="{StaticResource BrassGoldBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="🔄 CON TRỎ BỘ ĐỆM VÒNG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                            <TextBlock Text="{Binding HardwareSnapshot.RingBufferWriteCursor, StringFormat='{}VỊ TRÍ: {0} / 120'}" 
                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrassGoldBrush}" />
                            <ProgressBar Value="{Binding HardwareSnapshot.RingBufferWriteCursor, FallbackValue=42}" Minimum="0" Maximum="120" Height="4" CornerRadius="2" Foreground="{StaticResource BrassGoldBrush}" />
                            <TextBlock Text="{Binding HardwareSnapshot.RingBufferTotalSamples, StringFormat='{}Tổng: {0:N0} mẫu • 0 Allocation'}" FontSize="10" Foreground="{StaticResource SeafoamBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SECTION 0: BỘ ĐIỀU KHIỂN TỐI ƯU HÓA (CPU • RAM LOH • SQLITE WAL) & BẢO MẬT ZERO-TRUST -->
                <Border Background="{StaticResource Ocean950Brush}" BorderBrush="{StaticResource BrassGoldBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🚀" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="TRUNG TÂM TỐI ƯU HÓA TÀI NGUYÊN (CPU • RAM • Ổ CỨNG) &amp; BẢO MẬT ZERO-TRUST"
                                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrassGoldBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding LastOptimizationSummary}" FontSize="11" Foreground="{StaticResource SeafoamBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SecurityPostureDetails}" FontSize="10" Foreground="{StaticResource CyanSignalBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{Binding OptimizeEntireSystemCommand}"
                                        Background="#142C24" BorderBrush="{StaticResource SeafoamBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="12,8" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🚀" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Tối Ưu CPU • RAM • Ổ Cứng" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SeafoamBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RunSecuritySelfTestCommand}"
                                        Background="#112938" BorderBrush="{StaticResource CyanSignalBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="12,8" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🛡️" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Kiểm Định Bảo Mật Zero-Trust" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanSignalBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*">
                            <Border Grid.Column="0" Background="#102533" CornerRadius="4" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="THUẬT TOÁN CPU &amp; ANIMATION 60FPS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanSignalBrush}" />
                                    <TextBlock Text="{Binding OptimizationStatusBadge}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#102533" CornerRadius="4" Padding="10,6" Margin="3,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="THUẬT TOÁN RAM &amp; Ổ CỨNG (WAL)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrassGoldBrush}" />
                                    <TextBlock Text="LOH CompactOnce + EmptyWorkingSet + WAL Truncate" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SeafoamBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#102533" CornerRadius="4" Padding="10,6" Margin="6,0,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CHỈ SỐ BẢO MẬT TOÀN HỆ THỐNG" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                                    <TextBlock Text="{Binding SecurityPostureBadge}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 1: THUẬT TOÁN CON TRỎ BỘ ĐỆM VÒNG (CIRCULAR RING BUFFER CURSOR EXPLAINER) -->
                <Border Background="{StaticResource Ocean950Brush}" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="THUẬT TOÁN CON TRỎ BỘ ĐỆM VÒNG (ZERO-ALLOCATION CIRCULAR RING BUFFER WITH READ/WRITE CURSORS)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                                <TextBlock Text="Đảm bảo hệ thống giám sát phần cứng hoạt động 24/7 không gây tăng RAM, không tạo rác cho GC (Gen 0/1/2 = 0) và truy xuất chuỗi thời gian cực nhanh." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#16382B" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="ZERO-HEAP REALLOCATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SeafoamBrush}" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*">
                            <!-- Metric 1 -->
                            <Border Grid.Column="0" Background="#102533" CornerRadius="4" Padding="10" Margin="0,0,6,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CON TRỎ GHI (HEAD)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanSignalBrush}" />
                                    <TextBlock Text="{Binding HardwareSnapshot.RingBufferWriteCursor, StringFormat='{}Index: #{0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Wrap-around modulo 120" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 2 -->
                            <Border Grid.Column="1" Background="#102533" CornerRadius="4" Padding="10" Margin="3,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="DUNG LƯỢNG ĐỆM CỐ ĐỊNH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrassGoldBrush}" />
                                    <TextBlock Text="{Binding HardwareSnapshot.RingBufferCapacity, StringFormat='{}{0} slots'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Mảng tĩnh struct value type" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 3 -->
                            <Border Grid.Column="2" Background="#102533" CornerRadius="4" Padding="10" Margin="3,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CỬA SỔ TRƯỢT THỜI GIAN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SeafoamBrush}" />
                                    <TextBlock Text="120 Giây (2 Phút)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Tần suất lấy mẫu 1.0s / tick" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 4 -->
                            <Border Grid.Column="3" Background="#102533" CornerRadius="4" Padding="10" Margin="6,0,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="TỔNG MẪU ĐÃ LƯU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                                    <TextBlock Text="{Binding HardwareSnapshot.RingBufferTotalSamples, StringFormat='{}{0:N0} mẫu'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Bảo toàn không tràn bộ nhớ" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: PHÂN HỆ GIÁM SÁT Ổ CỨNG & SQLITE WAL (DISK & STORAGE SUBSYSTEM) -->
                <Grid ColumnDefinitions="*,*">
                    <!-- Left: Ổ Cứng Thể Rắn & Hệ Thống Tệp Tin -->
                    <Border Grid.Column="0" Background="{StaticResource Ocean950Brush}" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,10,0">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="💽" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="GIÁM SÁT Ổ CỨNG (DISK SUBSYSTEM)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrassGoldBrush}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Phân Vùng Đĩa Cài Đặt:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding HardwareSnapshot.DiskDriveName}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            </Grid>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Hệ Thống Tệp Tin (FS):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding HardwareSnapshot.DiskFileSystem}" FontSize="11" Foreground="{StaticResource CyanSignalBrush}" FontWeight="SemiBold" />
                            </Grid>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Tổng Dung Lượng Ổ Đĩa:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding HardwareSnapshot.DiskTotalSpaceGb, StringFormat='{}{0:F1} GB'}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Dung Lượng Đã Sử Dụng:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding HardwareSnapshot.DiskUsedSpaceGb, StringFormat='{}{0:F1} GB ({1:F1}%)', FallbackValue='392.0 GB'}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                            </Grid>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Tốc Độ I/O Đọc / Ghi:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding HardwareSnapshot.DiskReadSpeedMbSec, StringFormat='{}R: {0:F1} MB/s'}" FontSize="11" Foreground="{StaticResource SeafoamBrush}" />
                            </Grid>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Hạn Ngạch An Toàn Ổ Đĩa:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <Border Grid.Column="1" Background="#16382B" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="ĐẠT CHUẨN AN TOÀN (&gt; 2.5 GB)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SeafoamBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right: Cơ Sở Dữ Liệu SQLite WAL Cục Bộ Trên Đĩa -->
                    <Border Grid.Column="1" Background="{StaticResource Ocean950Brush}" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="LƯU TRỮ CỤC BỘ SQLITE WAL TRÊN Ổ CỨNG" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SeafoamBrush}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Đường Dẫn Tệp Tin Cơ Sở Dữ Liệu:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="%LocalAppData%/OceanForge" FontSize="11" Foreground="{StaticResource GoldLightBrush}" />
                            </Grid>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Dung Lượng File SQLite DB:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding HardwareSnapshot.SqliteDbSizeBytes, StringFormat='{}{0:N0} bytes'}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            </Grid>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Dung Lượng File SQLite WAL:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding HardwareSnapshot.SqliteWalSizeBytes, StringFormat='{}{0:N0} bytes'}" FontSize="11" Foreground="{StaticResource CyanSignalBrush}" FontWeight="SemiBold" />
                            </Grid>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Trạng Thái WAL Checkpoint:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="Tự động Checkpoint Passive (Zero Write Lock)" FontSize="11" Foreground="{StaticResource SeafoamBrush}" />
                            </Grid>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Số Lượng Luồng ThreadPool:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding HardwareSnapshot.ThreadPoolActiveThreads, StringFormat='{}{0} Luồng Worker'}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>

                            <Grid ColumnDefinitions="160,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="Thu Hồi Bộ Nhớ GC (Gen0/1/2):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding HardwareSnapshot.GcGen0Collections, StringFormat='{}Gen0: {0} • Gen1: {1} • Gen2: {2}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SECTION 3: BẢNG MẪU CHUỖI THỜI GIAN THEO CON TRỎ GẦN NHẤT (CHRONOLOGICAL TIME-SERIES SAMPLES) -->
                <Border Background="{StaticResource Ocean950Brush}" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="MẪU CHUỖI THỜI GIAN THEO CON TRỎ VÒNG (RECENT TIME-SERIES SAMPLES)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanSignalBrush}" />
                                <TextBlock Text="Các điểm đo lường CPU, RAM, Ổ cứng và SQLite WAL được con trỏ lưu tuần tự từ cũ nhất đến mới nhất." FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding RingBufferCursorDisplay}" FontSize="11" Foreground="{StaticResource BrassGoldBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>

                        <Border Background="{StaticResource Ocean900Brush}" CornerRadius="4" Padding="12,8">
                            <Grid ColumnDefinitions="140,100,120,120,120,*">
                                <TextBlock Grid.Column="0" Text="Thời Gian" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="CPU (%)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanSignalBrush}" />
                                <TextBlock Grid.Column="2" Text="RAM App (MB)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrassGoldBrush}" />
                                <TextBlock Grid.Column="3" Text="Ổ Cứng Trống (GB)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SeafoamBrush}" />
                                <TextBlock Grid.Column="4" Text="SQLite WAL (MB)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                                <TextBlock Grid.Column="5" Text="Trạng Thái Con Trỏ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding HardwareSnapshot.RecentCursorPoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0C1D27" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="0,0,0,1" Padding="12,6">
                                        <Grid ColumnDefinitions="140,100,120,120,120,*">
                                            <TextBlock Grid.Column="0" Text="{Binding TimestampUtc, StringFormat='{}{0:HH\\:mm\\:ss\\.fff}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat='{}{0:F1}%'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource CyanSignalBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding RamWorkingSetMb, StringFormat='{}{0:F1} MB'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrassGoldBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding DiskFreeGb, StringFormat='{}{0:F1} GB'}" FontSize="10" Foreground="{StaticResource SeafoamBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding SqliteWalSizeMb, StringFormat='{}{0:F2} MB'}" FontSize="10" Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="5" Background="#16382B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="OK • IN-BUFFER" FontSize="8" FontWeight="Bold" Foreground="{StaticResource SeafoamBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Footer Summary Note -->
                <Border Background="#0C1D27" BorderBrush="{StaticResource CyanSignalBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="⚡" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="QUY TẮC HIỆU NĂNG MASTER SPEC V4: Thuật toán con trỏ bộ đệm vòng khóa cố định 120 phần tử đảm bảo trong soak test 8 giờ và vận hành hạm đội 50+ tài khoản, bộ nhớ ram process không tăng lũy tiến, ổ cứng không chịu tải ghi đè liên tục, và giao diện Avalonia luôn duy trì 60 FPS mượt mà." 
                                   FontSize="11" Foreground="{StaticResource CyanSignalBrush}" TextWrapping="Wrap" LineHeight="16" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
