<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OceanForge.Desktop.ViewModels"
             x:Class="OceanForge.Desktop.Views.UpdatesView"
             x:DataType="vm:MainViewModel">

    <Border Background="{StaticResource Ocean950Brush}" Padding="20">
        <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="17. QUẢN LÝ PHIÊN BẢN &amp; CẬP NHẬT (RELEASE CHANNEL &amp; UPDATES)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrassGoldBrush}" />
                <TextBlock Text="Kiểm tra phiên bản ứng dụng, chữ ký số phát hành và kênh phân phối chính thức (Stable / Beta / Nightly)." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- Version Status Card -->
            <Border Background="{StaticResource Ocean900Brush}" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="OceanForge Desktop v4.0.0 LTS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                            <Border Background="#16382B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="PHIÊN BẢN MỚI NHẤT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SeafoamBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Đã xác thực chữ ký SHA-256 chính thức từ GitHub Release. Gói ứng dụng tự chứa chạy độc lập trên Windows x64 và Linux x64." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <TextBlock Text="● Kênh: Stable LTS" FontSize="10" Foreground="{StaticResource SeafoamBrush}" />
                            <TextBlock Text="● Target: .NET 10.0 (net10.0)" FontSize="10" Foreground="{StaticResource CyanSignalBrush}" />
                            <TextBlock Text="● Avalonia UI: 12.1.4" FontSize="10" Foreground="{StaticResource BrassGoldBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="🔄 Kiểm Tra Bản Mới" Background="{StaticResource BrassGoldBrush}" Foreground="{StaticResource Ocean950Brush}" FontWeight="Bold" CornerRadius="4" Padding="14,8" Cursor="Hand" VerticalAlignment="Center" FontSize="11" />
                </Grid>
            </Border>

            <!-- Release Notes -->
            <Border Background="{StaticResource Ocean900Brush}" BorderBrush="{StaticResource Ocean800Brush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="NHẬT KÝ PHIÊN BẢN 4.0.0 (RELEASE NOTES)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanSignalBrush}" />
                    
                    <StackPanel Spacing="6">
                        <TextBlock Text="• Tích hợp trọn vẹn Telemetry Blox Fruits Update 30 (Magnet Power, Secrets, V4 Races)." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="• Bổ sung thuật toán FNV-1a 32-bit Checksum Fast-path Deduplication giảm 90% tải CPU." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="• Triển khai Hội đồng 4 Multi-AI Personas tranh biện và xuất phán quyết đồng thuận." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="• Tích hợp Kho Wiki Blox Fruits Fandom đầy đủ 7 danh mục và Bản đồ Thế giới 3 Sea." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="• Tích hợp quy trình Đăng nhập Google &amp; Discord OAuth2 an toàn tuyệt đối." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
