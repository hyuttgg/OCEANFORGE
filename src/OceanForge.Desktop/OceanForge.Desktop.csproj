<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OceanForge.Domain\OceanForge.Domain.csproj" />
    <ProjectReference Include="..\OceanForge.Contracts\OceanForge.Contracts.csproj" />
    <ProjectReference Include="..\OceanForge.Application\OceanForge.Application.csproj" />
    <ProjectReference Include="..\OceanForge.Local.Persistence\OceanForge.Local.Persistence.csproj" />
    <ProjectReference Include="..\OceanForge.Telemetry\OceanForge.Telemetry.csproj" />
    <ProjectReference Include="..\OceanForge.AI\OceanForge.AI.csproj" />
  </ItemGroup>
</Project>
