{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OceanForge Update Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "channel",
    "version",
    "minimumUpdaterVersion",
    "publishedAtUtc",
    "releaseNotesUrl",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "product": { "type": "string", "const": "OceanForge Desktop" },
    "channel": { "type": "string", "enum": ["stable", "beta", "nightly"] },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$" },
    "minimumUpdaterVersion": { "type": "string" },
    "publishedAtUtc": { "type": "string", "format": "date-time" },
    "releaseNotesUrl": { "type": "string", "format": "uri" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rid", "packageType", "url", "sizeBytes", "sha256", "signaturePolicy"],
        "properties": {
          "rid": { "type": "string", "enum": ["win-x64", "linux-x64"] },
          "packageType": { "type": "string", "enum": ["msix", "exe", "deb", "appimage", "zip", "tar.gz"] },
          "url": { "type": "string", "pattern": "^https://" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "signaturePolicy": { "type": "string" }
        }
      }
    }
  }
}
